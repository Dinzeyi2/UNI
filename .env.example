# Nexus application secrets — copy to .env locally or set as deployment secrets.
# Never send these values in chat, commit them, or expose them to the browser.
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
SESSION_SECRET=replace-with-at-least-32-random-characters
NEXUS_TOKEN_KEY=replace-with-a-separate-32-byte-token-encryption-secret
NEXUS_BASE_URL=http://localhost:4173
CORS_ORIGIN=http://localhost:4173

# SmartThings OAuth application. Register:
# ${NEXUS_BASE_URL}/api/oauth/smartthings/callback
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=

# Home Assistant instance. Generate a long-lived access token in Home Assistant.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# Local Nexus agent (run inside the home, never on Railway).
NEXUS_AGENT_HOST=127.0.0.1
NEXUS_AGENT_PORT=4180
NEXUS_AGENT_TOKEN=replace-with-a-long-random-agent-api-token
NEXUS_AGENT_SECRET=replace-with-a-separate-local-encryption-secret
NEXUS_AGENT_STATE=.nexus-local-agent.json
NEXUS_AGENT_RUNTIME_STATE=.nexus-local-runtime.json
NEXUS_ADAPTER_MODULES=

# Optional local controller sidecars. They must bind to loopback and require a token.
# The sidecars own Matter commissioning/HomeKit HAP cryptography; Nexus owns policy/runtime.
MATTER_BRIDGE_URL=
MATTER_BRIDGE_TOKEN=
HOMEKIT_BRIDGE_URL=
HOMEKIT_BRIDGE_TOKEN=

# Recommended complete local controller path: pair Matter/HomeKit devices in the
# bundled/local Home Assistant controller, then Nexus discovers and controls them locally.
LOCAL_HOME_ASSISTANT_URL=
LOCAL_HOME_ASSISTANT_TOKEN=

# Optional OpenAI-compatible structured-output compiler.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional outbound-only synchronization from the home agent to Railway.
NEXUS_CLOUD_URL=
NEXUS_CLOUD_AGENT_TOKEN=
NEXUS_CLOUD_SYNC_INTERVAL_MS=10000
