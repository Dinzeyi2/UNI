# Use a high-entropy secret in production; never commit production secrets.
NEXUS_TOKEN_KEY=replace-with-a-long-random-secret
NEXUS_BASE_URL=https://app.example.com

# SmartThings OAuth application credentials.
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=

# Home Assistant local/cloud endpoint and a user-created long-lived access token.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Production persistence and optional structured LLM compiler.
DATABASE_URL=postgresql://nexus:change-me@localhost:5432/nexus
SESSION_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=https://your-lovable-app.lovable.app
OPENAI_API_KEY=
OPENAI_MODEL=
